# E2E_PROJECT_CREDITS=2000
# E2E_SLOW_PROJECT_CREDITS=500
# E2E_LOG_FORMAT=text
# E2E_LOG_LEVEL=info

# Workers belong to the machine, so set PLAYWRIGHT_WORKERS in .env.local.
