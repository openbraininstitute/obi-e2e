{
  "name": "obi-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end Playwright tests for the OBI web app, generated from plain-English scenarios",
  "type": "module",
  "scripts": {
    "test": "bun --bun playwright test",
    "auth": "E2E_RUN_ID=live bun --bun playwright test --project=setup",
    "test:smoke": "bun --bun playwright test --grep @smoke",
    "test:ui": "bun --bun playwright test --ui",
    "test:headed": "bun --bun playwright test --headed",
    "test:debug": "bun --bun playwright test --debug",
    "report": "bun --bun playwright show-report",
    "codegen": "bun --bun playwright codegen \"${E2E_BASE_URL:-https://staging.openbraininstitute.org}\"",
    "browsers": "bunx playwright install --with-deps chromium",
    "summarize": "bun scripts/ci/summarize-results.ts test-results/results.json test-results",
    "notify": "bun run summarize && bun scripts/ci/teams-card.ts test-results/summary.json",
    "test:unit": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:unit"
  },
  "dependencies": {
    "better-result": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
