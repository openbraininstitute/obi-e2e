{
  "name": "obi-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end Playwright tests for the OBI web app, generated from plain-English scenarios",
  "type": "module",
  "scripts": {
    "test": "bun --bun playwright test",
    "test:local": "E2E_BASE_URL=http://localhost:3001 bun --bun playwright test",
    "auth": "E2E_RUN_ID=live bun --bun playwright test --project=setup",
    "preflight": "bun scripts/ci/preflight.ts",
    "reclaim": "bun scripts/ci/reclaim.ts",
    "test:ui": "bun --bun playwright test --ui",
    "test:headed": "bun --bun playwright test --headed",
    "test:debug": "bun --bun playwright test --debug",
    "report": "bun --bun playwright show-report",
    "codegen": "bun --bun playwright codegen \"${E2E_BASE_URL:-https://staging.openbraininstitute.org}\"",
    "browsers": "bunx playwright install --with-deps chromium",
    "summarize": "bun scripts/ci/summarize-results.ts test-results/results.json test-results",
    "notify": "bun scripts/ci/notify.ts",
    "test:unit": "bun test ./scripts ./fixtures ./locators ./tools ./perf",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run site:check && bun run test:unit",
    "scenario": "bun scripts/scenario.ts",
    "casebook": "bun tools/casebook/validator/cli.ts",
    "perf": "bun perf/run.ts",
    "site": "vite --config gh-web/vite.config.ts",
    "site:build": "vite build --config gh-web/vite.config.ts",
    "site:check": "tsc -p gh-web --noEmit",
    "site:fixtures": "bun gh-web/fixtures.ts"
  },
  "dependencies": {
    "better-result": "^3.0.1",
    "es-toolkit": "^1.52.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.18.0",
    "@types/bun": "1.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "oxc-parser": "^0.148.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
