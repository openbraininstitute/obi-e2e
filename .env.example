# Copy to `.env` for local runs. Never commit `.env`.
# An environment is one URL plus the test users. CI uses the same names.

E2E_BASE_URL=https://staging.openbraininstitute.org

# Primary user. Owns the virtual lab the suite runs inside.
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=

# The lab and project the primary user's tests may write to.
LAB_ID=
PROJECT_ID=

# Onboarding user. Owns no virtual lab, so it can test creating one.
# Optional: leave blank and the onboarding tests skip.
E2E_ONBOARDING_USERNAME=
E2E_ONBOARDING_PASSWORD=

# Optional
# PLAYWRIGHT_BROWSER=chromium|firefox|webkit
# PLAYWRIGHT_WORKERS=3

# Backend services. Each is health-checked before the suite runs.
# Defaults point at staging; override only to test another deployment.
# ENTITY_CORE_URL=https://staging.cell-a.openbraininstitute.org/api/entitycore
# VIRTUAL_LAB_API_URL=https://staging.cell-a.openbraininstitute.org/api/virtual-lab-manager
# OBI_ONE_URL=https://staging.cell-a.openbraininstitute.org/api/obi-one
# CELL_API_URL=https://staging.cell-a.openbraininstitute.org/api/circuit
# NOTEBOOK_API_URL=https://staging.cell-a.openbraininstitute.org/api/notebook_service
# THUMBNAIL_API_URL=https://staging.cell-a.openbraininstitute.org/api/thumbnail-generation
# SMALL_SCALE_SIMULATOR_URL=https://staging.cell-a.openbraininstitute.org/api/small-scale-simulator
# AI_AGENT_URL=https://staging.cell-a.openbraininstitute.org/api/agent-ts/api
# AUTH_MANAGER_URL=https://staging.cell-a.openbraininstitute.org/api/auth-manager/v1
# LAUNCH_SYSTEM_URL=https://staging.cell-a.openbraininstitute.org/api/launch-system

# Teams webhook for the result card. CI supplies this as a secret.
# TEAMS_WEBHOOK_URL=

# How the result reaches Teams.
#   unset    one message carrying everything (default)
#   split    the summary first, then one message per section
#   thread   every card in one request, for a flow that posts then replies
# Only `thread` produces a real thread, and it needs the Power Automate flow
# changed to reply. See the README.
# TEAMS_LAYOUT=split
