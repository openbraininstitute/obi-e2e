# Copy to `.env` for local runs. Never commit `.env`.
# Environment = one URL + one test user. Same secret names are used in CI.

# Target application (staging | production | PR preview URL)
E2E_BASE_URL=https://staging.openbraininstitute.org

# QA test user (Keycloak)
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=

# QA virtual lab + project. Tests must never touch data outside these.
LAB_ID=
PROJECT_ID=

# Optional
# PLAYWRIGHT_BROWSER=chromium|firefox|webkit
# PLAYWRIGHT_WORKERS=3
