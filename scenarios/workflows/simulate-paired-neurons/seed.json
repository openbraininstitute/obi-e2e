{
  "name": "Paired neurons simulation",
  "activity": "simulate",
  "env": ["staging", "production"],
  "workflow": {
    "label": "Paired neurons",
    "type": "paired-neuron-circuit-simulation"
  },
  "schemaName": "CircuitSimulationScanConfig",
  "selection": {
    "mode": "single",
    "entities": ["nbS1-O1-E2PV-maxNsyn-HEX0-L2"]
  },
  "cases": [
    {
      "name": "a constant current clamp on every biophysical neuron",
      "config": {
        "info": {
          "type": "Info",
          "campaign_name": "E2E paired neurons simulation",
          "campaign_description": "One clamp on every biophysical neuron, recorded at the soma."
        },
        "timestamps": {
          "regular": {
            "type": "RegularTimestamps",
            "start_time": 0,
            "interval": 1000,
            "number_of_repetitions": 1
          }
        },
        "neuron_sets": {
          "all_neurons": {
            "type": "AllBiophysicalNeurons"
          }
        },
        "stimuli": {
          "current_clamp": {
            "type": "ConstantCurrentClampSomaticStimulus",
            "timestamps": {
              "block_dict_name": "timestamps",
              "block_name": "regular"
            },
            "neuron_set": {
              "block_dict_name": "neuron_sets",
              "block_name": "all_neurons"
            },
            "duration": 800,
            "amplitude": 0.5
          }
        },
        "recordings": {
          "soma_voltage": {
            "type": "SomaVoltageRecording",
            "neuron_set": {
              "block_dict_name": "neuron_sets",
              "block_name": "all_neurons"
            },
            "dt": 0.1
          }
        },
        "initialize": {
          "type": "CircuitSimulationScanConfig.Initialize",
          "node_set": {
            "block_dict_name": "neuron_sets",
            "block_name": "all_neurons"
          },
          "simulation_length": 1000
        }
      },
      "expect": {
        "coordinateCount": 1,
        "generated": {
          "inputs": [
            "Circuit directory",
            "node_sets.json",
            "obi_one_coordinate.json",
            "simulation_config.json"
          ],
          "outputs": []
        },
        "completed": {
          "inputs": [
            "Circuit directory",
            "node_sets.json",
            "obi_one_coordinate.json",
            "simulation_config.json"
          ],
          "outputs": ["Recording 0.h5", "spikes.h5"],
          "views": {
            "Recording 0.h5": [
              "S1nonbarrel_neurons_0",
              "S1nonbarrel_neurons_1",
              "Time (ms)",
              "Voltage (mV)"
            ],
            "spikes.h5": ["PopulationS1nonbarrel_neurons", "spikes"]
          }
        }
      }
    }
  ]
}
