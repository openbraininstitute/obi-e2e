{
  "name": "Paired neurons simulation of the synapse-parameterized pair",
  "activity": "simulate",
  "env": ["staging", "production"],
  "workflow": {
    "label": "Paired neurons",
    "type": "paired-neuron-circuit-simulation"
  },
  "schemaName": "CircuitSimulationScanConfig",
  "selection": {
    "mode": "single",
    "scope": "project",
    "entities": ["nbS1-O1-E2PV-maxNsyn-HEX0-L2 (synapse-parameterized)"]
  },
  "cases": [
    {
      "name": "the parameterized pair, clamped and recorded the way the original pair is",
      "config": {
        "info": {
          "type": "Info",
          "campaign_name": "E2E parameterized pair simulation",
          "campaign_description": "The pair the synaptic physiology build registered, clamped and recorded at the soma."
        },
        "timestamps": {
          "regular": {
            "type": "RegularTimestamps",
            "start_time": 0,
            "interval": 1000,
            "number_of_repetitions": 1
          }
        },
        "neuron_sets": {
          "all_neurons": {
            "type": "AllBiophysicalNeurons"
          }
        },
        "stimuli": {
          "current_clamp": {
            "type": "ConstantCurrentClampSomaticStimulus",
            "timestamps": {
              "block_dict_name": "timestamps",
              "block_name": "regular"
            },
            "neuron_set": {
              "block_dict_name": "neuron_sets",
              "block_name": "all_neurons"
            },
            "duration": 800,
            "amplitude": 0.5
          }
        },
        "recordings": {
          "soma_voltage": {
            "type": "SomaVoltageRecording",
            "neuron_set": {
              "block_dict_name": "neuron_sets",
              "block_name": "all_neurons"
            },
            "dt": 0.1
          }
        },
        "initialize": {
          "type": "CircuitSimulationScanConfig.Initialize",
          "node_set": {
            "block_dict_name": "neuron_sets",
            "block_name": "all_neurons"
          },
          "simulation_length": 1000
        }
      },
      "expect": {
        "coordinateCount": 1,
        "generated": {
          "inputs": [
            "Circuit directory",
            "Node sets",
            "OBI-ONE Config",
            "SONATA Simulation Config"
          ],
          "outputs": []
        },
        "completed": {
          "inputs": [
            "Circuit directory",
            "Node sets",
            "OBI-ONE Config",
            "SONATA Simulation Config"
          ],
          "outputs": ["Recording 0", "S1nonbarrel_neurons"],
          "views": {
            "Recording 0": ["2 cells recorded", "Time (ms)", "Voltage (mV)"],
            "S1nonbarrel_neurons": ["PopulationS1nonbarrel_neurons", "spikes"]
          }
        }
      }
    }
  ]
}
