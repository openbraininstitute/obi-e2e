# Copy to .env.staging.local, and again to .env.production.local.
# Same keys, different values: the two deployments keep separate realms.

E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=

# Owns no lab, so it can test creating one. Leave blank to skip those tests.
E2E_ONBOARDING_USERNAME=
E2E_ONBOARDING_PASSWORD=

# The lab the primary user's tests run inside, on this deployment.
LAB_ID=

# Where the result card goes. CI supplies its own.
MS_TEAMS_WEBHOOK_URI=
